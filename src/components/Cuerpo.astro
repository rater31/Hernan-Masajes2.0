---
import { Image } from "astro:assets";
import cuerpoImg from "../img/cuidado2.webp";
import detalleImg from "../img/cuidado.webp";
import { waLink } from "../lib/contacto";

const actividades = [
  {
    numero: "01",
    titulo: "Estiramientos",
    descripcion:
      "Mejoran la movilidad, liberan tensiones acumuladas y devuelven elasticidad al cuerpo.",
  },
  {
    numero: "02",
    titulo: "Ejercicios funcionales",
    descripcion:
      "Trabajo consciente para fortalecer, estabilizar y acompañar el movimiento diario.",
  },
  {
    numero: "03",
    titulo: "Esferodinamia",
    descripcion:
      "Movilidad, equilibrio y relajación sobre esferas, con atención en la respiración.",
  },
];
---

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1fr] lg:items-center lg:gap-20">
      <div class="relative" data-reveal="left">
        <Image
          src={cuerpoImg}
          alt="Estiramientos y ejercicio funcional para el cuidado del cuerpo"
          class="aspect-[4/5] w-full rounded-3xl object-cover"
        />
        <div
          class="pointer-events-none absolute inset-0 rounded-3xl border border-white/10"
          aria-hidden="true"
        ></div>
        <div class="absolute -right-4 -bottom-8 hidden w-44 overflow-hidden rounded-2xl border-4 border-ink shadow-2xl shadow-black/50 sm:block lg:w-48">
          <Image
            src={detalleImg}
            alt="Detalle de una sesión de cuidado corporal"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>

      <div data-reveal="right" style="--reveal-delay: 120ms">
        <p class="text-xs uppercase tracking-[0.32em] text-gold">
          Cuidado corporal
        </p>
        <h2 class="mt-5 max-w-xl text-4xl leading-[1.02] text-cream sm:text-5xl">
          Moverte mejor,
          <span class="italic text-gold"> sentirte mejor.</span>
        </h2>
        <p class="mt-6 max-w-xl text-sm leading-relaxed text-muted sm:text-base">
          Cuidemos el cuerpo con estiramientos, ejercicios funcionales y
          esferodinamia, actividades que también ayudan a la relajación de la
          mente y el cuerpo.
        </p>

        <ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
          {actividades.map((actividad) => (
            <li class="flex gap-5 py-4">
              <span class="pt-0.5 font-display text-sm text-gold">
                {actividad.numero}
              </span>
              <div>
                <h3 class="text-sm font-semibold tracking-wide text-cream">
                  {actividad.titulo}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">
                  {actividad.descripcion}
                </p>
              </div>
            </li>
          ))}
        </ul>

        <a
          href={waLink("Hola, quisiera consultar por cuidado corporal")}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-gold-bright"
        >
          Consultar por WhatsApp
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
