---
import logo from "../img/logo.png";
import {
  WHATSAPP_TEL,
  waLink,
  INSTAGRAM_URL,
  FACEBOOK_URL,
} from "../lib/contacto";
import { NAV_LINKS, withBase } from "../lib/navegacion";

const year = new Date().getFullYear();
const socialLinks = [
  { href: INSTAGRAM_URL, label: "Instagram" },
  { href: FACEBOOK_URL, label: "Facebook" },
  { href: waLink("Hola, quisiera consultar por un turno"), label: "WhatsApp" },
];
---

<footer
  id="contacto"
  class="relative overflow-hidden border-t border-white/10 bg-charcoal"
>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-80 w-[42rem] -translate-x-1/2 rounded-full bg-gold/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div
      class="grid gap-10 border-b border-white/10 pb-16 lg:grid-cols-[1.4fr_1fr] lg:items-end"
      data-reveal
    >
      <div>
        <p class="text-xs uppercase tracking-[0.32em] text-gold">Reservas</p>
        <h2 class="mt-4 max-w-2xl text-4xl leading-[1.05] text-cream sm:text-5xl">
          Tu próximo momento de bienestar empieza con un mensaje.
        </h2>
      </div>
      <div>
        <p class="max-w-sm text-sm leading-relaxed text-muted">
          Atención personalizada en Salta, Argentina. Coordinamos día y horario
          según disponibilidad.
        </p>
        <a
          href={waLink("Hola, quisiera reservar un turno")}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-gold-bright"
        >
          Reservar por WhatsApp
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="grid gap-12 py-14 md:grid-cols-3">
      <div>
        <a
          href={withBase("/")}
          class="inline-flex items-center gap-3"
          aria-label="Hernán Masajes, ir al inicio"
        >
          <span class="grid size-14 shrink-0 place-items-center rounded-full border border-gold/20 bg-gold/[0.05]">
            <img
              src={logo.src}
              alt=""
              width={112}
              height={112}
              decoding="async"
              class="brand-logo size-12 object-contain"
              aria-hidden="true"
            />
          </span>
          <span class="leading-none">
            <span class="block font-display text-xl tracking-wide text-cream">
              Hernán Masajes
            </span>
            <span class="mt-1 block text-[9px] uppercase tracking-[0.32em] text-gold/80">
              Bienestar & estética
            </span>
          </span>
        </a>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-muted">
          Masajes, cuidado corporal y estética en un espacio pensado para bajar
          el ritmo y volver a sentirte bien.
        </p>
        <ul class="mt-6 flex flex-wrap gap-4 text-xs uppercase tracking-[0.2em]">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cream/60 transition-colors hover:text-gold"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-[0.32em] text-gold">Servicios</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {NAV_LINKS.filter((link) => !link.cta).map((link) => (
            <li>
              <a
                href={link.href}
                class="text-cream/70 transition-colors hover:text-gold"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-[0.32em] text-gold">Contacto</h3>
        <ul class="mt-5 space-y-3 text-sm text-cream/70">
          <li>
            <a
              href={`tel:+${WHATSAPP_TEL.replace(/\D/g, "")}`}
              class="transition-colors hover:text-gold"
            >
              {WHATSAPP_TEL}
            </a>
          </li>
          <li>
            <a
              href={waLink("Hola, quisiera consultar")}
              target="_blank"
              rel="noopener noreferrer"
              class="transition-colors hover:text-gold"
            >
              WhatsApp
            </a>
          </li>
          <li>Salta, Argentina</li>
          <li class="text-muted">Atención con cita previa</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Hernán Masajes. Todos los derechos reservados.</p>
      <a href="#top" class="transition-colors hover:text-gold">
        Volver arriba <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>
