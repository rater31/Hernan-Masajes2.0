---
import logo from "../img/logo.png";
import { NAV_LINKS, withBase } from "../lib/navegacion";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  (href.replace(/\/+$/, "") || "/") === currentPath;
const navLinks = NAV_LINKS.filter((link) => !link.cta);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/80 backdrop-blur-xl">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a
      href={withBase("/")}
      class="group flex items-center gap-3"
      aria-label="Hernán Masajes, ir al inicio"
    >
      <span class="grid size-14 shrink-0 place-items-center rounded-full border border-gold/20 bg-gold/[0.05]">
        <img
          src={logo.src}
          alt=""
          width={112}
          height={112}
          loading="eager"
          decoding="async"
          class="brand-logo size-12 object-contain transition-transform duration-300 group-hover:scale-105"
          aria-hidden="true"
        />
      </span>
      <span class="leading-none">
        <span class="block font-display text-xl tracking-wide text-cream">
          Hernán Masajes
        </span>
        <span class="mt-1 block text-[9px] uppercase tracking-[0.32em] text-gold/80">
          Bienestar & estética
        </span>
      </span>
    </a>

    <nav
      class="hidden items-center gap-8 lg:flex"
      aria-label="Navegación principal"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "relative text-sm transition-colors after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-gold after:transition-all",
            isActive(link.href)
              ? "text-gold after:w-full"
              : "text-cream/70 after:w-0 hover:text-cream hover:after:w-full",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href={withBase("/contacto")}
        aria-current={isActive(withBase("/contacto")) ? "page" : undefined}
        class="rounded-full border border-gold/60 px-5 py-2.5 text-sm font-medium text-gold transition-colors hover:bg-gold hover:text-ink"
      >
        Reservar turno
      </a>
    </nav>

    <details class="menu relative lg:hidden">
      <summary class="flex size-10 cursor-pointer list-none flex-col items-center justify-center rounded-full border border-white/15 transition-colors hover:border-gold/50">
        <span class="sr-only">Abrir menú</span>
        <span class="line line-1"></span>
        <span class="line line-2"></span>
        <span class="line line-3"></span>
      </summary>

      <div class="panel absolute right-0 top-full mt-8 w-[min(18rem,calc(100vw-2.5rem))] overflow-hidden rounded-2xl border border-white/10 bg-charcoal p-2 shadow-2xl shadow-black/60">
        <nav aria-label="Navegación móvil">
          <ul class="flex flex-col">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "block rounded-xl px-4 py-3 text-sm transition-colors",
                    isActive(link.href)
                      ? "bg-white/5 text-gold"
                      : "text-cream/75 hover:bg-white/5 hover:text-cream",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
            <li class="mt-1">
              <a
                href={withBase("/contacto")}
                class="block rounded-xl bg-gold px-4 py-3 text-center text-sm font-semibold text-ink transition-colors hover:bg-gold-bright"
              >
                Reservar turno
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .line {
    height: 2px;
    width: 22px;
    border-radius: 999px;
    background-color: currentColor;
    color: var(--color-cream);
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }
  .line + .line {
    margin-top: 5px;
  }
  .menu[open] .line-1 {
    transform: translateY(7px) rotate(45deg);
  }
  .menu[open] .line-2 {
    opacity: 0;
  }
  .menu[open] .line-3 {
    transform: translateY(-7px) rotate(-45deg);
  }
  .menu[open] .panel {
    animation: panel-in 220ms ease-out;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
