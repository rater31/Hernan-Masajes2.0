---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/10">
  <div
    class="pointer-events-none absolute -top-32 right-0 h-72 w-72 rounded-full bg-gold/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <p class="text-xs uppercase tracking-[0.32em] text-gold" data-reveal>
      {eyebrow}
    </p>
    <div class="mt-5 grid gap-6 lg:grid-cols-[1.2fr_1fr] lg:items-end">
      <h1
        class="max-w-3xl text-5xl leading-[0.95] text-cream sm:text-6xl lg:text-7xl"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {title}
      </h1>
      <p
        class="max-w-md text-sm leading-relaxed text-muted lg:pb-2"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        {description}
      </p>
    </div>
  </div>
</section>
