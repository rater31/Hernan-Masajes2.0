---
import { Image } from "astro:assets";
import type { ListaMasaje } from "../lib/masajes";
import Acordeon from "../components/Acordeon.astro";
import { waLink } from "../lib/contacto";

interface Props {
  listamasajes: ListaMasaje;
}

const { listamasajes } = Astro.props;
const { title, especificaciones, items, fondo } = listamasajes;
---

<article
  data-reveal
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-charcoal transition duration-300 hover:-translate-y-1 hover:border-gold/40 hover:shadow-[0_24px_60px_-24px_rgba(201,168,106,0.25)]"
>
  <div class="relative h-44 overflow-hidden sm:h-48">
    <Image
      src={fondo}
      alt=""
      class="h-full w-full object-cover opacity-75 transition duration-700 group-hover:scale-105 group-hover:opacity-100"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/20 to-transparent"
      aria-hidden="true"
    ></div>
    <span
      class="absolute top-5 left-5 h-px w-10 bg-gold/70"
      aria-hidden="true"
    ></span>
  </div>

  <div class="flex flex-1 flex-col px-6 pt-2 pb-6">
    <h2 class="text-3xl leading-[1.05] text-cream">{title}</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{especificaciones}</p>

    {items.length > 0 && (
      <div class="mt-5 border-t border-white/10 pt-1">
        <Acordeon items={items} />
      </div>
    )}

    <a
      href={waLink(`Hola, quisiera solicitar un turno para ${title}`)}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto inline-flex items-center gap-2 pt-6 text-xs font-semibold uppercase tracking-[0.18em] text-gold transition-colors hover:text-gold-bright"
    >
      Reservar este masaje
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
