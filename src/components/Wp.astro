---
import { Image } from "astro:assets";
import logoWap from "../img/whatsapp-svgrepo-com.svg";
import { WHATSAPP_URL } from "../lib/contacto";
---

<a
  href={WHATSAPP_URL}
  class="group fixed right-5 bottom-5 z-40 flex size-14 items-center justify-center rounded-full bg-[#25d366] shadow-[0_12px_40px_rgba(37,211,102,0.35)] transition-transform hover:scale-105"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
>
  <span
    class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25d366]/30"
    aria-hidden="true"
  ></span>
  <Image
    src={logoWap}
    alt=""
    class="size-7 brightness-0 invert"
    aria-hidden="true"
  />
</a>
