---
import { ClientRouter } from "astro:transitions";
import ico from "../../public/favicon.ico";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Wp from "../components/Wp.astro";
import {
  SITE_NAME,
  WHATSAPP_NUMBER,
  INSTAGRAM_URL,
  FACEBOOK_URL,
} from "../lib/contacto";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Masajes y estética corporal en Salta, Argentina. Atención con cita previa. Solicitá tu turno por WhatsApp.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageURL = new URL(
  `${import.meta.env.BASE_URL}og-image.jpg`,
  Astro.site ?? Astro.url,
);
const ogImageAlt =
  "Logo de Hernán Masajes sobre fondo oscuro: bienestar y estética en Salta";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: SITE_NAME,
  description,
  telephone: `+${WHATSAPP_NUMBER}`,
  sameAs: [FACEBOOK_URL, INSTAGRAM_URL],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Salta",
    addressCountry: "AR",
  },
  areaServed: "Salta, Argentina",
  ...(Astro.site ? { url: canonicalURL.href, image: ogImageURL.href } : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08080a" />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-ready");
      }
    </script>
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="shortcut icon" href={ico} type="image/x-icon" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <ClientRouter />
  </head>
  <body
    id="top"
    class="flex min-h-screen flex-col bg-ink text-cream selection:bg-gold selection:text-ink"
  >
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-gold focus:px-5 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Saltar al contenido
    </a>
    <Header />
    <slot name="hero" />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Wp />
    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>
