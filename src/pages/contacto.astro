---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import {
  WHATSAPP_TEL,
  waLink,
  INSTAGRAM_URL,
  FACEBOOK_URL,
} from "../lib/contacto";

const contraindicaciones = [
  "Si tenés fiebre.",
  "Si tenés alguna enfermedad en la piel que sea contagiosa.",
  "Si te operaste recientemente.",
  "Si tenés diarrea.",
];
---

<Layout
  title="Hernán Masajes | Contacto en Salta, Argentina"
  description="Contactate con Hernán Masajes en Salta, Argentina. Atención con cita previa por WhatsApp o teléfono."
>
  <PageHero
    eyebrow="Contacto"
    title="Reservá tu turno."
    description="Atención personalizada en Salta, Argentina. Escribinos por WhatsApp o llamanos para coordinar día y horario."
  />

  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <div
          class="rounded-3xl border border-white/10 bg-charcoal p-7 sm:p-9 lg:p-10"
          data-reveal="left"
        >
          <p class="text-xs uppercase tracking-[0.32em] text-gold">Hablemos</p>
          <h2 class="mt-4 text-4xl leading-tight text-cream sm:text-5xl">
            Coordinemos una sesión.
          </h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">
            Contanos qué servicio te interesa y qué días te quedan cómodos.
            Verificamos disponibilidad y te confirmamos el turno.
          </p>

          <a
            href={waLink("Hola, quisiera reservar un turno")}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-flex items-center gap-2 rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-gold-bright"
          >
            Escribinos por WhatsApp
            <span aria-hidden="true">↗</span>
          </a>

          <dl class="mt-10 grid gap-6 border-t border-white/10 pt-8 sm:grid-cols-2">
            <div>
              <dt class="text-[10px] uppercase tracking-[0.22em] text-gold">
                Teléfono
              </dt>
              <dd class="mt-2 text-sm text-cream/80">
                <a
                  href={`tel:+${WHATSAPP_TEL.replace(/\D/g, "")}`}
                  class="transition-colors hover:text-gold"
                >
                  {WHATSAPP_TEL}
                </a>
              </dd>
            </div>
            <div>
              <dt class="text-[10px] uppercase tracking-[0.22em] text-gold">
                Ubicación
              </dt>
              <dd class="mt-2 text-sm text-cream/80">Salta, Argentina</dd>
            </div>
            <div>
              <dt class="text-[10px] uppercase tracking-[0.22em] text-gold">
                Modalidad
              </dt>
              <dd class="mt-2 text-sm text-cream/80">
                Atención con cita previa
              </dd>
            </div>
            <div>
              <dt class="text-[10px] uppercase tracking-[0.22em] text-gold">
                Redes
              </dt>
              <dd class="mt-2 flex gap-4 text-sm text-cream/80">
                <a
                  href={INSTAGRAM_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-gold"
                >
                  Instagram
                </a>
                <a
                  href={FACEBOOK_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-colors hover:text-gold"
                >
                  Facebook
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div
          class="rounded-3xl border border-gold/20 bg-gradient-to-b from-charcoal to-ink p-7 sm:p-9 lg:p-10"
          data-reveal="right"
          style="--reveal-delay: 120ms"
        >
          <p class="text-xs uppercase tracking-[0.32em] text-gold">
            Antes de reservar
          </p>
          <h2 class="mt-4 text-3xl leading-tight text-cream">
            Razones por las que no podrías recibir un masaje
          </h2>
          <ul class="mt-7 space-y-4">
            {contraindicaciones.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-cream/75">
                <span
                  class="mt-2 size-1 shrink-0 rounded-full bg-gold"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-8 border-t border-white/10 pt-6 text-xs leading-relaxed text-muted">
            Si tenés alguna duda sobre tu situación, escribinos antes de
            reservar. Te orientamos con gusto.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
